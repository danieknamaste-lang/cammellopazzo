#!/bin/bash
# Start the Ollama-DeepSeek proxy under a self-healing supervisor.
#
# Why a supervisor?  On Android 12+ / Termux, backgrounded child processes are
# routinely killed within seconds by the OS "phantom process" reaper and the
# low-memory killer. That is the usual cause of "the proxy dies after a few
# seconds". We can't stop Android from killing the Python process from inside
# it, so instead we:
#   1. acquire an Android wake lock (termux-wake-lock) if available, and
#   2. run the proxy inside a detached (setsid) supervisor loop that restarts
#      it whenever it exits, until stop-proxy asks it to quit.
# See README.md for the ADB one-liner that disables the phantom killer outright.

set -u

if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
  echo "ERROR: DEEPSEEK_API_KEY non impostata"
  echo "Uso: DEEPSEEK_API_KEY=sk-... start-proxy"
  exit 1
fi

DIR="$(cd "$(dirname "$0")" && pwd)"
PROXY="$DIR/ollama-deepseek-proxy"
RUNDIR="${TMPDIR:-/tmp}"
LOG="$RUNDIR/deepseek-proxy.log"
SUP_PIDFILE="$RUNDIR/deepseek-proxy.supervisor.pid"
STOPFLAG="$RUNDIR/deepseek-proxy.stop"

# If a supervisor is already running, do nothing.
if [ -f "$SUP_PIDFILE" ] && kill -0 "$(cat "$SUP_PIDFILE" 2>/dev/null)" 2>/dev/null; then
  echo "Proxy gia' in esecuzione (supervisor PID: $(cat "$SUP_PIDFILE"))"
  exit 0
fi

# Clean up any stale processes/flags from a previous run.
pkill -f "ollama-deepseek-proxy" 2>/dev/null
rm -f "$STOPFLAG"

# Keep the CPU awake so Android doesn't suspend the process (best effort).
command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock 2>/dev/null

# The supervisor loop: restart the proxy whenever it exits, unless asked to stop.
supervisor() {
  echo "[supervisor] avviato $(date)"
  while [ ! -f "$STOPFLAG" ]; do
    env DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY" python3 -u "$PROXY"
    code=$?
    [ -f "$STOPFLAG" ] && break
    echo "[supervisor] proxy uscito (code=$code), riavvio tra 2s $(date)"
    sleep 2
  done
  echo "[supervisor] terminato $(date)"
  command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock 2>/dev/null
  rm -f "$SUP_PIDFILE"
}

# Detach the supervisor into its own session so it survives the parent shell.
if command -v setsid >/dev/null 2>&1; then
  setsid bash -c "$(declare -f supervisor); \
    DEEPSEEK_API_KEY='$DEEPSEEK_API_KEY' PROXY='$PROXY' STOPFLAG='$STOPFLAG' \
    SUP_PIDFILE='$SUP_PIDFILE' supervisor" >"$LOG" 2>&1 &
else
  nohup bash -c "$(declare -f supervisor); \
    DEEPSEEK_API_KEY='$DEEPSEEK_API_KEY' PROXY='$PROXY' STOPFLAG='$STOPFLAG' \
    SUP_PIDFILE='$SUP_PIDFILE' supervisor" >"$LOG" 2>&1 &
fi
SUP_PID=$!
echo "$SUP_PID" > "$SUP_PIDFILE"

# Confirm the proxy actually came up.
for _ in 1 2 3 4 5 6 7 8; do
  if grep -q "Ready on" "$LOG" 2>/dev/null; then
    echo "Proxy avviato (supervisor PID: $SUP_PID) su http://127.0.0.1:11434"
    echo "Log: $LOG"
    exit 0
  fi
  kill -0 "$SUP_PID" 2>/dev/null || break
  sleep 0.5
done

echo "ERRORE: proxy non avviato"
cat "$LOG" 2>/dev/null
rm -f "$SUP_PIDFILE"
exit 1
