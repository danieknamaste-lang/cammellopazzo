#!/usr/bin/env python3
"""Threaded Ollama-to-DeepSeek proxy with request logging."""

import json, os, sys, urllib.request, urllib.error, socketserver, traceback
from http.server import HTTPServer, BaseHTTPRequestHandler

DEEPSEEK_API_KEY = os.environ.get("DEEPSEEK_API_KEY", "")
DEEPSEEK_URL = "https://api.deepseek.com/v1/chat/completions"
HOST, PORT = "127.0.0.1", 11434

def log(msg):
    print(msg, flush=True)

try:
    class ThreadedServer(socketserver.ThreadingMixIn, HTTPServer):
        allow_reuse_address = True

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            log(f"GET {self.path}")
            if self.path == "/api/tags":
                return self.json(200, {
                    "models": [{"name": "deepseek-chat:latest", "modified_at": "2026-07-05T00:00:00Z",
                               "size": 0, "digest": "sha256:abc123",
                               "details": {"format": "gguf", "family": "deepseek",
                                          "parameter_size": "7B", "quantization_level": "Q4_0"}}]})
            self.send_error(404)

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
            try:
                req = json.loads(body)
            except:
                return self.json(400, {"error": "bad json"})
            log(f"POST {self.path} model={req.get('model')} stream={req.get('stream')}")
            
            if self.path in ("/api/chat", "/api/generate"):
                messages = req.get("messages", [])
                if not messages and self.path == "/api/generate":
                    messages = [{"role": "user", "content": req.get("prompt", "")}]
                stream = req.get("stream", False)
                model = {"deepseek-chat": "deepseek-chat", "deepseek-coder": "deepseek-coder"}.get(req.get("model", ""), "deepseek-chat")
                payload = {"model": model, "messages": messages, "stream": stream}
                headers = {"Authorization": f"Bearer {DEEPSEEK_API_KEY}", "Content-Type": "application/json"}
                try:
                    dreq = urllib.request.Request(DEEPSEEK_URL, data=json.dumps(payload).encode(), headers=headers, method="POST")
                    with urllib.request.urlopen(dreq, timeout=120) as resp:
                        if stream:
                            self.send_response(200)
                            self.send_header("Content-Type", "application/x-ndjson")
                            self.end_headers()
                            buf = ""
                            while True:
                                chunk = resp.read(4096)
                                if not chunk: break
                                buf += chunk.decode(errors="replace")
                                lines = buf.split("\n")
                                buf = lines[-1]
                                for line in lines[:-1]:
                                    if line.startswith("data: ") and line[6:].strip() != "[DONE]":
                                        try:
                                            d = json.loads(line[6:])
                                            content = d["choices"][0].get("delta", {}).get("content", "")
                                            if content:
                                                self.wfile.write(json.dumps({"model": model, "message": {"role": "assistant", "content": content}, "done": False}).encode() + b"\n")
                                                self.wfile.flush()
                                        except: pass
                            self.wfile.write(json.dumps({"model": model, "message": {"role": "assistant", "content": ""}, "done": True}).encode() + b"\n")
                            self.wfile.flush()
                        else:
                            data = json.loads(resp.read())
                            c = data["choices"][0]["message"]
                            self.json(200, {"model": model, "message": {"role": c.get("role", "assistant"), "content": c.get("content", "")}, "done": True})
                    log(f"DeepSeek OK")
                except urllib.error.HTTPError as e:
                    log(f"DeepSeek HTTP {e.code}")
                    self.json(e.code, {"error": e.read().decode(errors="replace")[:500]})
                except Exception as e:
                    log(f"DeepSeek error: {e}")
                    self.json(500, {"error": str(e)})
            elif self.path == "/api/show":
                self.json(200, {"license": "MIT", "modelfile": "", "details": {"family": "deepseek"}})
            else:
                self.json(404, {"error": "not found"})

        def json(self, status, data):
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(data).encode())

        def log_message(self, *a): pass

    DEEPSEEK_API_KEY = os.environ.get("DEEPSEEK_API_KEY", sys.argv[1] if len(sys.argv) > 1 else "")
    if not DEEPSEEK_API_KEY:
        log("FATAL: No API key")
        sys.exit(1)
    srv = ThreadedServer((HOST, PORT), Handler)
    log(f"Ready on {HOST}:{PORT}")
    srv.serve_forever()
except Exception as e:
    log(f"FATAL: {e}")
    traceback.print_exc(file=sys.stderr)
    sys.exit(1)
